* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color:rgb(218, 218, 255);
    color: #192b50;
}

/* HEADER */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    background-color: rgb(218, 218, 255);
}
.Profile-pic{
    margin-right: 50px;
}
.logo {
    font-size: 28px;
    color: #2455a4;
    font-weight: 800;
}

.logo span {
    color: rgb(249, 32, 126);
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    text-decoration: none;
    color: rgb(139, 139, 226);
    font-weight: 600;
    transition: 0.3s;
    font-size: large;
}

nav a:hover {
    color: rgb(238, 50, 135);
}

/* HERO SECTION */
.hero {
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 8%;
    background: linear-gradient( rgb(218, 218, 255) , rgb(245, 45, 152), rgb(218, 218, 255))
}
.description{
    font-weight: 16px;
    max-width: 650px;
    margin: 0 ,auto ,30px;
    color: rgb(98, 98, 157);
    line-height:1.8;
}
.hero-content{
    max-width: 800px;
}

/*QUALITIES SECTION*/
.qualities-section{
    padding: 80px 85%;
}
.section-heading{
    text-align: center;
    max-width: 650px;
    margin: 0 auto 45px;
}
.subtitle{
    color: rgba(231, 81, 171, 0.821);
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 3px;
    margin-bottom: 12px;
}
.section-heading h1{
    font-size:clamp (28px 40px);
    color: darkblue;
    margin-bottom: 15px;
}
 .section-heading h1 span{
    color: rgb(241, 0, 149);
}

/*THREE WIDGETS IN A ROW*/
.widgets{
   display: flex;
   flex-direction: row;
   justify-content: center;
   gap: 25px;
   width: 350px;
   margin: 0 auto;
   text-align:center ;
   height: auto;  
}
/*INDIVIDUAL WIDGET*/
.widget{
    flex: 1;
    min-width: 0;
    background:linear-gradient( rgb(255, 18, 137),darkblue) ;
    color: white;
    padding: 35px 25px;
    border-radius: 22px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.hi-button{
    border-color: none;
    border-radius: 2px;
    color: white;
    background-color: rgb(255, 0, 153);
    width: 32px;
    height: 20px;
    border: 0;
}
/*WIDGET HEADING*/
.widget h3{
    font-size: 25px;
    margin-bottom: 15px;
    color: white;
}
/*WIDGET PARAGRAPH*/
.widget p{
    color: whitesmoke;
    font-size: 15px;
}
/*Footer*/
footer {
    background-color: rgb(247, 69, 193);
    color: rgb(19, 18, 18);
    text-align: center;
    padding: 20px;
    font-size: 16px;
}
footer span{
    color:rgb(red green blue / alpha);
    font-family: Cambria, Cochin, Georgia, Times, 'Times New Roman', serif;
    font-weight: bold;
}
@media screen and (max-width: 768px){
    .header{
        flex-direction:  column;
        gap: 20px;
